# Database - Using SQLite for development
DATABASE_URL=sqlite:///./kavach_ai.db
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./kavach_ai.db

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Kavach AI
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Security
SECRET_KEY=kavach-ai-secret-key-change-this-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (optional for now)
REDIS_HOST=localhost
REDIS_PORT=6379