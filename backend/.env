# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kavach_ai
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:your_password@localhost:5432/kavach_ai

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Kavach AI
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (for real-time updates)
REDIS_HOST=localhost
REDIS_PORT=6379